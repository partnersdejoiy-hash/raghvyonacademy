# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Client ID for Google Sign-in & Drive
GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_SECRET: Optional Google OAuth 2.0 Client Secret (Server-side token exchange only)
GOOGLE_CLIENT_SECRET=""

# SESSION_SECRET: Secret key for signing sessions and encrypting sensitive tokens
SESSION_SECRET="raghvyon_secure_jwt_session_secret_change_in_prod"


# Super admin: always has every permission and edits role permissions.
ADMIN_EMAIL=deepak@raghvyon.co.in
# Set privately in your backend host's environment. Never commit a real password.
ADMIN_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Redesign (Vercel + Cloudflare D1) ----
# Vercel Functions in api/ talk to Cloudflare D1 over its REST API.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=64c6ba42-dfa2-4ab5-ad33-c798beecf936
# Cloudflare API token with the "D1: Edit" permission only.
CF_API_TOKEN=
# OAuth client ID (public); the portal reads it from /api/config.
